{% comment %}
  Renders a product card.
  Accepts:
  - card_product: Product object
{% endcomment %}

<article class="product-card">
  <a class="product-card__media" href="{{ card_product.url }}">
    {% if card_product.featured_image != blank %}
      {{ card_product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320,480,640,800,1000', sizes: '(min-width: 990px) 25vw, 50vw', alt: card_product.featured_image.alt | default: card_product.title }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}

    {% unless card_product.available %}
      <span class="badge">{{ 'products.product.sold_out' | t }}</span>
    {% endunless %}
  </a>

  <div class="product-card__info">
    <div>
      <h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
      {% if card_product.vendor != blank %}<p>{{ card_product.vendor | escape }}</p>{% endif %}
    </div>
    <strong>{{ card_product.price | money }}</strong>
  </div>
</article>
