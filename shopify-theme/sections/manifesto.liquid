<section class="manifesto-section section-space">
  <div class="page-width manifesto-grid">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="rte manifesto-copy">{{ section.settings.text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Manifesto",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "02 / PROCESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Less noise. More wear."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A compact uniform of dependable layers, easy proportions, and useful objects. Built as a native Shopify Liquid portfolio theme.</p>"
    }
  ],
  "presets": [
    {
      "name": "Manifesto"
    }
  ]
}
{% endschema %}
