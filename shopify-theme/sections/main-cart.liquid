<section class="page-width section-space cart-page">
  <div class="section-heading">
    <h1>{{ 'sections.cart.title' | t }}</h1>
    {% if cart.item_count > 0 %}<span>{{ cart.item_count }} {{ 'sections.cart.items' | t }}</span>{% endif %}
  </div>

  {% if cart.item_count == 0 %}
    <div class="empty-state">
      <h2>{{ 'sections.cart.empty' | t }}</h2>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="cart-lines">
        {% for item in cart.items %}
          <div class="cart-line">
            <a class="cart-line__image" href="{{ item.url }}">
              {% if item.image %}{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: item.title }}{% endif %}
            </a>
            <div class="cart-line__details">
              <a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>
              {% unless item.product.has_only_default_variant %}<span>{{ item.variant.title | escape }}</span>{% endunless %}
              <span>{{ item.final_price | money }}</span>
              <a href="{{ item.url_to_remove }}">{{ 'sections.cart.remove' | t }}</a>
            </div>
            <label class="cart-line__quantity">
              {{ 'products.product.quantity.label' | t }}
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ item.product.title | escape }} quantity">
            </label>
            <strong>{{ item.final_line_price | money }}</strong>
          </div>
        {% endfor %}
      </div>

      <div class="cart-summary">
        <p>{{ 'sections.cart.subtotal' | t }} <strong>{{ cart.total_price | money_with_currency }}</strong></p>
        <p class="muted">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>
        <div class="cart-actions">
          <button class="button button--secondary" type="submit" name="update">{{ 'sections.cart.update' | t }}</button>
          <button class="button" type="submit" name="checkout">{{ 'sections.cart.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
