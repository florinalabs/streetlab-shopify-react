<section class="hero-section hero-section--{{ section.settings.alignment }}">
  <div class="page-width hero-grid">
    <div class="hero-copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
      {% if section.settings.text != blank %}<div class="rte hero-text">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} <span>→</span></a>
      {% endif %}
    </div>

    <div class="hero-media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '480,720,960,1200,1600,1800', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.heading }}
      {% else %}
        <div class="hero-poster" aria-hidden="true">
          <span>STREETLAB®</span>
          <strong>02</strong>
          <small>MANILA / PH</small>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "StreetLab hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "STUDIO 02 / 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for the in-between."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Everyday pieces for work, movement, and everything after. Designed in Manila with a quiet utility mindset.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    }
  ],
  "presets": [
    {
      "name": "StreetLab hero"
    }
  ]
}
{% endschema %}
