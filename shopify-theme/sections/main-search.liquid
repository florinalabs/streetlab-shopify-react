<section class="page-width section-space">
  <div class="collection-header">
    <p class="eyebrow">{{ 'general.search.search' | t }}</p>
    <h1>{{ 'general.search.title' | t }}</h1>
  </div>

  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button class="button" type="submit">{{ 'general.search.submit' | t }}</button>
  </form>

  {% if search.performed %}
    {% paginate search.results by 12 %}
      <p class="search-count">{{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }}</p>
      <div class="product-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', card_product: item %}
          {% endif %}
        {% endfor %}
      </div>
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Main search",
  "settings": []
}
{% endschema %}
